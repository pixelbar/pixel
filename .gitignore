# dependencies & build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# local env & secrets
.env
.env.*
!.env.example

# access lists contain personal data — only examples are committed
config/*.yaml
config/*.bak
!config/*.example.yaml

# the home device list describes the building — only the example is committed
config/home-assistant/*.yaml
!config/home-assistant/*.example.yaml

# runtime state (e.g. data/space.state)
data/

# os / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.example.tfvars
backend.azurerm.hcl
tfplan

# claude
.claude/worktrees/
.dev-data/
