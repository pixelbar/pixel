# dependencies & build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# local env & secrets — never commit tokens
.env
.env.dev
.env.prod
.env.*
!.env.example

# access lists contain personal data — only examples are committed
config/*.yaml
config/*.bak
!config/*.example.yaml

# half-written files from atomic writes (write `<file>.tmp`, then rename). A crash
# in between leaves a full copy, e.g. config/members.yaml.<pid>.tmp,
# config/admins.dev.yaml.tmp or infra/envs/*/terraform.tfvars.tmp
*.tmp

# the home device list describes the building — only the example is committed
config/home-assistant/*.yaml
!config/home-assistant/*.example.yaml
# per-env mirrors of the Azure files, written by `just ha-devices` and `just pull`
config/home-assistant/*/
config/dev/
config/prod/

# runtime state (e.g. data/space.state)
data/

# os / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.example.tfvars
backend.azurerm.hcl
tfplan

# claude
.claude/worktrees/
.dev-data/

# docs site (VitePress) build output and cache
docs/.vitepress/cache/
docs/.vitepress/dist/
