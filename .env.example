# Copy to .env and fill in. Never commit .env.

# local | dev | prod
PIXEL_ENV=local
LOG_LEVEL=debug

# Your own dev bot — never the production one. See README.
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# Optional: the channel where announcements and the weekly poll are posted. /info points people at it.
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=

# Optional: announce when the space opens/closes. Either, both or neither; they can be the same channel.
# Live: one post per opening, edited to "closed" when it closes.
DISCORD_ANNOUNCE_LIVE_CHANNEL_ID=
# Timeline: a new post for every open and every close.
DISCORD_ANNOUNCE_TIMELINE_CHANNEL_ID=

# Optional
SENTRY_DSN=
# PIXEL_ADMINS_FILE=config/admins.yaml
# PIXEL_MEMBERS_FILE=config/members.yaml
# HEALTH_PORT=8080
# SPACEAPI_URL=https://spaceapi.pixelbar.nl/
# PIXEL_DATA_DIR=data
# PIXEL_TIMEZONE=Europe/Amsterdam
# PIXEL_CONTENT_DIR=content
