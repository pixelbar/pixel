# Copy to .env (just dev), .env.dev (just register dev) and .env.prod
# (just register prod). Never commit these files. Never copy tokens between them.
# .env.prod must set PIXEL_ENV=prod.

# local | dev | prod
PIXEL_ENV=local
# local | cloud. Azure Container Apps sets cloud. /admin status and the online post show this as Where.
# PIXEL_RUNTIME=local
LOG_LEVEL=debug
# A rotating log file (JSON lines, last ~2 weeks) is written here. Empty turns it off. The console and
# Sentry Logs get the same entries.
# PIXEL_LOG_DIR=data/logs

# Your own dev bot — never the production one. See README.
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# Optional: the channel where announcements and the weekly poll are posted. /info points people at it.
# Pixel also says here when it comes online and goes offline (version, commit, branch, status).
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
# Optional: post Pixel's online/offline status somewhere else instead of the announcements channel.
# DISCORD_ANNOUNCE_BOT_CHANNEL_ID=

# Open/closed announcements aren't set here: admins choose channels and styles with
# /admin announcements set (saved in PIXEL_DATA_DIR/announcement-routes.yaml).

# Optional: closing-time reminder (members: /closing-time, and automatically after space-close).
# Channel ID, or off / none / empty to disable both paths.
# DISCORD_CLOSING_TIME_CHANNEL_ID=
# Message body (multi-line markdown). Default data/closing-time.md. Missing file → built-in default.
# Admins set it with /admin closing-time set (writes this file on the persist share).
# Not a secret: never put door codes or passwords in it. Pixel reads it each time it posts.
# PIXEL_CLOSING_TIME_FILE=data/closing-time.md

# Optional: mirror membership to Discord roles, by role name or ID. When an admin changes someone's
# level, Pixel gives or takes these roles. Pixel never reads roles to decide a level. Leave unset
# to leave Discord alone. The bot needs Manage Roles, and its highest role must sit above these.
DISCORD_ROLE_MEMBER=
DISCORD_ROLE_FRIEND=

# Optional: toot announcements to a Mastodon account. Set both instance and token, or neither.
# Missing config leaves Mastodon off; Discord still works. The token is a secret (write:statuses).
# Never hard-code an instance or account in the repo. See docs/runbook.md (Mastodon).
# MASTODON_INSTANCE=https://mastodon.example
# MASTODON_ACCESS_TOKEN=
# Public handle for logs only (the token decides which account posts). Optional.
# MASTODON_ACCOUNT=pixel@mastodon.example
# unlisted (default) or public. Never private or direct.
# MASTODON_VISIBILITY=unlisted
# Which announcement kinds to toot. Default space.status. Comma-separated, or off / none.
# MASTODON_ANNOUNCE_KINDS=space.status

# Optional: let members with the `spacestate` capability set the space open or closed with
# /spacestate set. Set all three or none. Pixel POSTs to the address with ?user=...&token=...&state=...
# and expects the answer SUCCESS. The user and token are secrets (Key Vault spacestate-user and
# spacestate-token when hosted). Missing config leaves /spacestate saying it isn't set up.
# SPACESTATE_API_URL=https://space.example/api/state
# SPACESTATE_USER=
# SPACESTATE_TOKEN=
# Optional, and a secret (Key Vault spacestate-additional-headers when hosted): extra headers sent
# with that call, as a JSON object of names to values.
# SPACESTATE_ADDITIONAL_HEADERS={"X-Example": "value"}

# Optional: control Home Assistant. Set both or neither. Use the address Pixel can reach it at (for
# example your Nabu Casa cloud URL) and a long-lived access token made by a NON-ADMIN Home Assistant
# user: Home Assistant can't limit a token to certain devices, so a non-admin user is the best fence.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Where the device allow-list lives. With Home Assistant set up, config/home-assistant/devices.yaml must exist.
# PIXEL_HOME_ASSISTANT_DIR=config/home-assistant

# Optional. Pixel reports errors here. CD / `just sentry-release` also need a
# Sentry auth token and org/project (not read by the bot). Leave them unset to skip.
SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# How many traces Sentry keeps (0–1). Default 1: every command and outbound HTTP call. Errors are
# always kept. Needs SENTRY_DSN.
# SENTRY_TRACES_SAMPLE_RATE=1
# How many of those traces get a CPU profile (0–1). Default 1. 0 turns profiling off.
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=1
# With Sentry set up, Pixel checks in with a Sentry cron monitor (pixel-<env>) this often, so Sentry can
# alert when it goes quiet. 0 turns it off. Default 5.
# PIXEL_HEARTBEAT_MINUTES=5
# PIXEL_ADMINS_FILE=config/admins.yaml
# PIXEL_MEMBERS_FILE=config/members.yaml
# HEALTH_PORT=8080
# SPACEAPI_URL=https://spaceapi.pixelbar.nl/
# PIXEL_DATA_DIR=data
# Time zone for /events, /schedule, and {{date}} tokens in user-set posts. Default Europe/Amsterdam.
# PIXEL_TIMEZONE=Europe/Amsterdam
# PIXEL_CONTENT_DIR=content
