# Copy to .env and fill in. Never commit .env.

# local | dev | prod
PIXEL_ENV=local
LOG_LEVEL=debug

# Random secret for pseudonymising users in logs and Sentry.
# Generate with: openssl rand -hex 32
PSEUDONYM_KEY=

# Your own dev bot — never the production one. See README.
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# Optional
SENTRY_DSN=
# PIXEL_ADMINS_FILE=config/admins.yaml
# PIXEL_MEMBERS_FILE=config/members.yaml
# HEALTH_PORT=8080
